      "[N167]            reason = \"excluded_glob\"",
      "[N168]        elif path.is_symlink():",
      "[N169]            reason = \"symlink\"",
      "[N170]        elif not path.is_file():",
      "[N171]            reason = \"not_regular_file\"",
      "[N172]",
      "[N173]        raw = b\"\"",
      "[N174]        if not reason:",
      "[N175]            try:",
      "[N176]                size = path.stat().st_size",
      "[N177]                if size > max_bytes:",
      "[N178]                    reason = \"too_large\"",
      "[N179]                else:",
      "[N180]                    raw = path.read_bytes()",
      "[N181]            except OSError:",
      "[N182]                reason = \"unreadable\"",
      "[N183]        if not reason and b\"\\0\" in raw:",
      "[N184]            reason = \"binary\"",
      "[N185]        if not reason:",
      "[N186]            try:",
      "[N187]                text = raw.decode(\"utf-8\")",
      "[N188]            except UnicodeDecodeError:",
      "[N189]                reason = \"non_utf8\"",
