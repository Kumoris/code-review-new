      "[N625]        comment = comment_text[:60] + (\"...\" if len(comment_text) > 60 else \"\")",
      "[N626]        report_lines.append(f\"| {i} | {comment} | {file_path}:{line} | {risk} |\")",
      "[N627]",
      "[N628]    if not valid_records:",
