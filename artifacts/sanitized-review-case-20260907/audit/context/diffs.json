      "[N248]def parse_diff_to_changed_files(diff_text: str) -> list:",
      "[N249]    \"\"\"Parse unified diff to extract changed file paths.\"\"\"",
      "[N250]    changed = []",
      "[N251]    old_path = \"\"",
      "[N252]    for line in diff_text.splitlines():",
      "[N253]        if line.startswith(\"--- a/\"):",
      "[N254]            old_path = line[6:]",
      "[N255]        elif line.startswith(\"+++ b/\"):",
      "[N256]            path = line[6:]",
      "[N257]            if path not in changed:",
      "[N258]                changed.append(path)",
      "[N259]        elif line == \"+++ /dev/null\" and old_path and old_path not in changed:",
      "[N260]            changed.append(old_path)",
      "[N261]    return changed",
