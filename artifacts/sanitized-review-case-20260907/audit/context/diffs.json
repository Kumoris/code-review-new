      "[N143]def whole_repo_snapshot(git_root: str, config: dict) -> tuple[list[dict], dict]:",
      "[N144]    \"\"\"Build review records where every included current line has an exact [N] anchor.\"\"\"",
      "[N145]    options = config.get(\"whole_repo\", {})",
      "[N146]    options = options if isinstance(options, dict) else {}",
