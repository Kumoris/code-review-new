      "[N227]def snapshot_revisions(git_root: str, args) -> tuple:",
      "[N228]    head = run_git(git_root, [\"rev-parse\", \"HEAD\"])",
      "[N229]    if args.base_branch:",
      "[N230]        base = run_git(git_root, [\"rev-parse\", f\"origin/{args.base_branch}\"])",
      "[N231]        selected_head = head",
      "[N232]    elif args.base_commit:",
      "[N233]        base = run_git(git_root, [\"rev-parse\", args.base_commit])",
      "[N234]        selected_head = head",
      "[N235]    elif args.range:",
      "[N236]        match = re.fullmatch(r\"(.+?)(\\.\\.\\.?)(.+)\", args.range)",
      "[N237]        if not match:",
      "[N238]            print(json.dumps({\"type\": \"ERROR\", \"error_type\": \"INVALID_RANGE\", \"message\": \"--range must be BASE..HEAD or BASE...HEAD\"}))",
      "[N239]            sys.exit(1)",
      "[N240]        base = run_git(git_root, [\"rev-parse\", match.group(1)])",
      "[N241]        selected_head = run_git(git_root, [\"rev-parse\", match.group(3)])",
      "[N242]    else:",
      "[N243]        base = selected_head = head",
      "[N244]    merge = subprocess.run([\"git\", \"merge-base\", base, selected_head], capture_output=True, text=True, cwd=git_root)",
