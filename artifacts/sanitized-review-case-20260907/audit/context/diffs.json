      "[N645]        severity_icon = {\"fatal\": \"🔴\", \"major\": \"🟠\", \"minor\": \"🟡\", \"suggestion\": \"🟢\"}.get(severity, \"\")",
      "[N646]",
      "[N647]        report_lines.extend([",
      "[N648]            f\"### {i}. {severity_icon} {severity_to_risk(severity)}\",",
      "[N649]            \"\",",
      "[N650]            f\"**文件位置**: {file_path}:{line}\",",
      "[N651]            \"\",",
      "[N652]            f\"**问题描述**：\",",
