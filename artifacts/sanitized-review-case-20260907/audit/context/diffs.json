      "[N264]def format_diff_with_anchors(diff_text: str) -> list:",
      "[N265]    \"\"\"Convert unified diff to diffs.json format with [N]/[C]/[O] anchors.",
      "[N266]",
      "[N267]    Returns a list of diff records, one per changed file.",
      "[N268]    Uses the unified GitHub/local context schema.",
      "[N269]    \"\"\"",
      "[N270]    import re",
      "[N271]",
      "[N272]    records = []",
      "[N273]    current_file = None",
      "[N274]    current_old_path = None",
      "[N275]    current_new_path = None",
      "[N276]    current_content = []",
      "[N277]",
      "[N278]    in_hunk = False",
      "[N279]    line_num_old = 0",
      "[N280]    line_num_new = 0",
      "[N281]    current_status = \"modified\"",
      "[N282]    patch_missing = False",
      "[N283]",
      "[N284]    for line in diff_text.splitlines():",
      "[N285]        if line.startswith(\"diff --git\"):",
      "[N286]            # Save previous file",
      "[N287]            if current_file:",
      "[N288]                records.append({",
      "[N289]                    \"file_path\": current_file,",
      "[N290]                    \"old_path\": current_old_path or current_file,",
      "[N291]                    \"new_path\": current_new_path,",
      "[N292]                    \"status\": current_status,",
      "[N293]                    \"patch_missing\": patch_missing,",
      "[N294]                    \"content\": current_content,",
      "[N295]                })",
      "[N296]            current_content = []",
      "[N297]            parts = shlex.split(line)",
      "[N298]            current_old_path = parts[2][2:] if len(parts) >= 4 and parts[2].startswith(\"a/\") else None",
      "[N299]            current_new_path = parts[3][2:] if len(parts) >= 4 and parts[3].startswith(\"b/\") else None",
      "[N300]            current_file = current_new_path or current_old_path",
      "[N301]            in_hunk = False",
      "[N302]            current_status = \"modified\"",
      "[N303]            patch_missing = False",
      "[N304]        elif line.startswith(\"new file mode\"):",
      "[N305]            current_status = \"added\"",
      "[N306]        elif line.startswith(\"deleted file mode\"):",
      "[N307]            current_status = \"removed\"",
      "[N308]        elif line.startswith(\"rename from \"):",
      "[N309]            current_old_path = line[len(\"rename from \"):]",
      "[N310]            current_status = \"renamed\"",
      "[N311]        elif line.startswith(\"rename to \"):",
      "[N312]            current_new_path = line[len(\"rename to \"):]",
      "[N313]            current_file = current_new_path",
      "[N314]            current_status = \"renamed\"",
      "[N315]        elif line.startswith(\"--- \"):",
      "[N316]            if line == \"--- /dev/null\":",
      "[N317]                current_old_path = None",
      "[N318]            else:",
      "[N319]                current_old_path = line[4:].strip()",
      "[N320]                if current_old_path.startswith(\"a/\"):",
      "[N321]                    current_old_path = current_old_path[2:]",
      "[N322]        elif line.startswith(\"+++ \"):",
      "[N323]            if line == \"+++ /dev/null\":",
      "[N324]                current_new_path = None",
      "[N325]                current_file = current_old_path",
      "[N326]            else:",
      "[N327]                current_new_path = line[4:].strip()",
      "[N328]                if current_new_path.startswith(\"b/\"):",
      "[N329]                    current_new_path = current_new_path[2:]",
      "[N330]                current_file = current_new_path",
      "[N331]        elif line.startswith(\"@@\"):",
      "[N332]            in_hunk = True",
      "[N333]            patch_missing = False",
      "[N334]            # Parse hunk header: @@ -start,count +start,count @@",
      "[N335]            m = re.search(r\"@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@\", line)",
      "[N336]            if m:",
      "[N337]                line_num_old = int(m.group(1)) - 1",
      "[N338]                line_num_new = int(m.group(2)) - 1",
      "[N339]            current_content.append(line)",
      "[N340]        elif in_hunk and current_file:",
      "[N341]            if line.startswith(\"-\"):",
      "[N342]                line_num_old += 1",
      "[N343]                current_content.append(f\"[O{line_num_old}]{line[1:]}\")",
      "[N344]            elif line.startswith(\"+\"):",
      "[N345]                line_num_new += 1",
      "[N346]                current_content.append(f\"[N{line_num_new}]{line[1:]}\")",
      "[N347]            elif line.startswith(\" \"):",
      "[N348]                line_num_old += 1",
      "[N349]                line_num_new += 1",
      "[N350]                current_content.append(f\"[C{line_num_new}]{line[1:]}\")",
      "[N351]            else:",
      "[N352]                current_content.append(line)",
      "[N353]        elif not in_hunk and current_file:",
      "[N354]            # Lines before first hunk (e.g., binary file indicator)",
      "[N355]            if line.startswith(\"Binary files \") or line == \"GIT binary patch\":",
      "[N356]                patch_missing = True",
      "[N357]            current_content.append(line)",
      "[N358]",
      "[N359]    # Save last file",
      "[N360]    if current_file:",
      "[N361]        records.append({",
      "[N362]            \"file_path\": current_file,",
      "[N363]            \"old_path\": current_old_path or current_file,",
      "[N364]            \"new_path\": current_new_path,",
      "[N365]            \"status\": current_status,",
      "[N366]            \"patch_missing\": patch_missing,",
      "[N367]            \"content\": current_content,",
      "[N368]        })",
      "[N369]",
      "[N370]    return records",
