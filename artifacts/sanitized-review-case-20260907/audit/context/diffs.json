      "[N487]def validate_record(record: dict) -> tuple:",
      "[N488]    \"\"\"Validate a review record has required fields.",
      "[N489]",
      "[N490]    Returns (is_valid, error_msg).",
      "[N491]    \"\"\"",
      "[N492]    required = [\"file_path\", \"line\", \"severity\", \"comment\", \"fix_suggestion\"]",
      "[N493]    for field in required:",
      "[N494]        if field not in record:",
      "[N495]            return False, f\"Missing required field: {field}\"",
      "[N496]",
      "[N497]    if record.get(\"severity\") not in [\"fatal\", \"major\", \"minor\", \"suggestion\"]:",
      "[N498]        return False, f\"Invalid severity: {record.get('severity')}\"",
      "[N499]",
      "[N500]    try:",
      "[N501]        line = int(record.get(\"line\", 0))",
      "[N502]        if line < 1:",
      "[N503]            return False, f\"Invalid line number: {line}\"",
      "[N504]    except (ValueError, TypeError):",
      "[N505]        return False, f\"Line must be an integer: {record.get('line')}\"",
      "[N506]",
      "[N507]    return True, \"\"",
      "[N508]",
      "[N509]",
      "[N510]def severity_to_risk(severity: str) -> str:",
      "[N511]    \"\"\"Convert severity to risk level for report.\"\"\"",
      "[N512]    mapping = {",
      "[N513]        \"fatal\": \"CRITICAL\",",
      "[N514]        \"major\": \"HIGH\",",
      "[N515]        \"minor\": \"MEDIUM\",",
      "[N516]        \"suggestion\": \"LOW\",",
      "[N517]    }",
      "[N518]    return mapping.get(severity, \"LOW\")",
