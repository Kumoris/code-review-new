      "[N198]            \"bytes\": len(raw),",
      "[N199]            \"line_count\": len(lines),",
      "[N200]            \"sha256\": digest,",
      "[N201]        })",
      "[N202]        header = f\"@@ -0,0 +1,{len(lines)} @@\" if lines else \"@@ -0,0 +0,0 @@\"",
      "[N203]        records.append({",
      "[N204]            \"file_path\": relative,",
      "[N205]            \"old_path\": relative,",
      "[N206]            \"new_path\": relative,",
      "[N207]            \"status\": \"snapshot\",",
      "[N208]            \"patch_missing\": False,",
      "[N209]            \"content\": [header, *(f\"[N{number}]{line}\" for number, line in enumerate(lines, 1))],",
      "[N210]        })",
      "[N211]",
      "[N212]    repository_sha = hashlib.sha256(_canonical_bytes(included)).hexdigest()",
      "[N213]    return records, {",
      "[N214]        \"schema_version\": \"1.0\",",
      "[N215]        \"mode\": \"whole_repo\",",
      "[N216]        \"repository_sha256\": repository_sha,",
      "[N217]        \"policy\": {",
      "[N218]            \"max_file_bytes\": max_bytes,",
      "[N219]            \"exclude_globs\": exclude_globs,",
      "[N220]            \"exclude_suffixes\": exclude_suffixes,",
      "[N221]        },",
      "[N222]        \"included_files\": included,",
      "[N223]        \"excluded_files\": excluded,",
      "[N224]    }",
