      "[N630]",
      "[N631]    report_lines.extend([",
      "[N632]        \"\",",
      "[N633]        \"## 详细问题列表\",",
      "[N634]    ])",
      "[N635]",
      "[N636]    for i, record in enumerate(valid_records, 1):",
      "[N637]        file_path = record.get(\"file_path\", \"\")",
      "[N638]        line = record.get(\"line\", \"\")",
      "[N639]        severity = record.get(\"severity\", \"\")",
      "[N640]        risk = severity_to_risk(severity)",
      "[N641]        comment = record.get(\"comment\", \"\")",
