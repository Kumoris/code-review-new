      "[N413]        review_mode = \"branch\"",
      "[N414]        baseline = f\"origin/{args.base_branch}\"",
      "[N415]    elif args.base_commit:",
      "[N416]        review_mode = \"commit\"",
      "[N417]        baseline = args.base_commit",
