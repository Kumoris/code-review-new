      "[N565]",
      "[N566]        valid_records.append(record)",
      "[N567]",
      "[N568]    # Sort by severity then by file_path",
      "[N569]    severity_order = {\"fatal\": 0, \"major\": 1, \"minor\": 2, \"suggestion\": 3}",
      "[N570]    valid_records.sort(key=lambda r: (severity_order.get(r.get(\"severity\"), 9), r.get(\"file_path\", \"\"), r.get(\"line\", 0)))",
      "[N571]",
      "[N572]    # Count by severity",
