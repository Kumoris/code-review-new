      "[N422]        review_mode = \"staged\"",
      "[N423]        baseline = \"HEAD\"",
      "[N424]",
      "[N425]    report_name = \"whole_repo_review\" if args.whole_repo else \"review_comments\"",
      "[N426]    report_path = Path(git_root) / \".code-review\" / f\"{report_name}_{datetime.now().strftime('%Y%m%d-%H%M%S')}.md\"",
      "[N427]",
      "[N428]    snapshot = {",
      "[N429]        \"base_sha\": base_sha,",
      "[N430]        \"head_sha\": head_sha,",
